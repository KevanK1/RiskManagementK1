{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run RiskManagementK1 (Mock Data)",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "cds",
      "args": [
        "serve",
        "--with-mocks",
        "--in-memory?"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Run RiskManagementK1-1",
      "runtimeExecutable": "cds",
      "request": "launch",
      "killBehavior": "polite",
      "args": [
        "watch",
        "--open"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "PreLaunchTask for Run RiskManagementK1-1",
      "envFile": "${workspaceFolder}/env/.env1",
      "env": {
        "run.config": "{\"handlerId\":\"lcap_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/RiskManagementK1\\\",\\\"profileName\\\":\\\"\\\"}\"}",
        "runConfigurations": "{\"authBinding\":{\"authType\":\"Dummy\"},\"odataBinding\":{\"OP_API_BUSINESS_PARTNER_SRV\":{\"destination\":\"apihub_sandbox\",\"type\":\"Destination\",\"path\":\"s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER\"},\"API_BUSINESS_PARTNER\":{\"destination\":\"apihub_sandbox\",\"type\":\"Destination\",\"path\":\"s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER\"}}}"
      }
    }
  ]
}